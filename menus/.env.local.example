# Copy this file to `.env.local`.
#
# These are public by construction — they ship inside the page's JavaScript,
# and the spreadsheet is readable by anyone with the link. Keep menu content
# only in that spreadsheet.
#
# Find them in the sheet's URL: the id sits between `/d/` and `/edit`, and each
# tab's gid appears as `gid=` when that tab is selected.

# Shared by every menu.
NEXT_PUBLIC_SHEET_ID=1iWT7zhnVM6vsD3lBXNxeVbOTtbBuiDCVh-N_7jo6dHY

# "Settings" tab — also shared by every menu.
NEXT_PUBLIC_SHEET_SETTINGS_GID=1853508676

# Each menu reads its own tab from its own variable, so leaving one unset fails
# only that menu's page. The food menu keeps the name it has always had.
#
# "Food Menu" tab
NEXT_PUBLIC_SHEET_MENU_GID=0

# "Wine Menu" tab
NEXT_PUBLIC_SHEET_WINE_GID=641246868
